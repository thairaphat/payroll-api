# ============================================================
# Payroll Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# Generate JWT_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# or:
#   openssl rand -base64 48
# ============================================================

# --- Database ---
DATABASE_URL="mysql://user:password@localhost:3306/db_name"
DATABASE_URL_DMS="mysql://user:password@localhost:3306/chaiyade_dms"
DATABASE_URL_WP106="mysql://user:password@localhost:3306/chaiyade_wp106"

# Optional: set to "false" if your MariaDB rejects public key retrieval
MARIADB_ALLOW_PUBLIC_KEY_RETRIEVAL="true"

# --- JWT ---
# REQUIRED. Must be set — server will refuse to start without it.
# Minimum 32 random characters. Keep secret, never share.
JWT_SECRET="replace-with-strong-random-secret-minimum-32-chars"

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# Must match the exact origin (scheme + host + port) of your React frontend.
# Example production: https://payroll.yourcompany.com
ALLOWED_ORIGINS="http://localhost:8080,http://localhost:8081,http://127.0.0.1:8080"

# --- Node Environment ---
# Use "production" on any server. Use "development" only on local machines
# when you explicitly need the dev bypass for testing without login.
NODE_ENV="production"

# --- Dev Auth Bypass (DEVELOPMENT ONLY) ---
# DANGER: Setting "true" allows role claims via X-User-Role request headers
# without a valid JWT. MUST be "false" or removed in all production environments.
ALLOW_DEV_AUTH_BYPASS="false"

# --- Google Sheets API (Service Account) ---
GOOGLE_CLIENT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
# Paste the full private key including BEGIN/END lines. Replace real newlines with \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_CONTENT_HERE\n-----END PRIVATE KEY-----\n"

# ─── Wage Configuration Note ─────────────────────────────────────────────────
# Daily wage is now DB-driven (payroll_wage_config table).
# After migration, insert the initial config row:
#   INSERT INTO payroll_wage_config (description, daily_wage, work_hours, effective_date, is_active)
#   VALUES ('Initial rate', 372.00, 8, CURDATE(), 1);
# If no row is active, the system falls back to the hardcoded constant (372 THB).
# ─────────────────────────────────────────────────────────────────────────────
