generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model categories {
  id          Int         @id @default(autoincrement())
  name        String      @unique(map: "name") @db.VarChar(120)
  description String?     @db.Text
  created_at  DateTime    @default(now()) @db.Timestamp(0)
  documents   documents[]
}

model companies {
  id                           Int                            @id @default(autoincrement())
  company_name                 String                         @db.VarChar(255)
  created_at                   DateTime                       @default(now()) @db.Timestamp(0)
  payroll_users                payroll_users[]
  payroll_runs                 payroll_runs[]
  payroll_run_items            payroll_run_items[]
  payroll_run_attendance_links payroll_run_attendance_links[]
}

model documents {
  id          Int         @id @default(autoincrement())
  doc_no      String      @unique(map: "doc_no") @db.VarChar(60)
  title       String      @db.VarChar(255)
  description String?     @db.Text
  category_id Int?
  file_name   String      @db.VarChar(255)
  file_path   String      @db.VarChar(255)
  mime_type   String      @db.VarChar(120)
  file_size   BigInt      @default(0)
  file_ext    String?     @default("") @db.VarChar(20)
  uploaded_by Int?
  downloads   Int?        @default(0)
  is_starred  Boolean?    @default(false)
  created_at  DateTime    @default(now()) @db.Timestamp(0)
  updated_at  DateTime    @default(now()) @db.Timestamp(0)
  categories  categories? @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "documents_ibfk_1")
  users       users?      @relation(fields: [uploaded_by], references: [id], onUpdate: NoAction, map: "documents_ibfk_2")

  @@index([category_id], map: "category_id")
  @@index([uploaded_by], map: "uploaded_by")
}

model employee_doc_groups {
  id                   Int                    @id @default(autoincrement())
  code                 String                 @unique(map: "code") @db.VarChar(20)
  title                String                 @db.VarChar(255)
  employee_doc_items   employee_doc_items[]
  employee_doc_uploads employee_doc_uploads[]
}

model employee_doc_items {
  id                   Int                    @id @default(autoincrement())
  group_id             Int
  item_code            String                 @db.VarChar(20)
  item_title           String                 @db.VarChar(255)
  sort_order           Int                    @default(0)
  employee_doc_groups  employee_doc_groups    @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "employee_doc_items_ibfk_1")
  employee_doc_uploads employee_doc_uploads[]

  @@index([group_id], map: "group_id")
}

model employee_doc_uploads {
  id                  Int                 @id @default(autoincrement())
  user_id             Int?
  employee_id         Int?
  group_id            Int
  item_id             Int
  is_checked          Boolean             @default(false)
  file_name           String?             @db.VarChar(255)
  file_path           String?             @db.VarChar(255)
  note                String?             @db.Text
  updated_at          DateTime            @default(now()) @db.Timestamp(0)
  created_at          DateTime            @default(now()) @db.Timestamp(0)
  employee_doc_groups employee_doc_groups @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "employee_doc_uploads_ibfk_1")
  employee_doc_items  employee_doc_items  @relation(fields: [item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "employee_doc_uploads_ibfk_2")

  @@index([group_id], map: "group_id")
  @@index([item_id], map: "item_id")
}

model employee_document_profiles {
  id                           Int                            @id @default(autoincrement())
  employee_id                  Int?
  company_id                   Int?
  emp_code                     String?                        @db.VarChar(100)
  employment_status            String?                        @db.VarChar(50)
  insurance_status             String?                        @db.VarChar(50)
  first_name                   String                         @default("") @db.VarChar(100)
  last_name                    String                         @default("") @db.VarChar(100)
  first_name_th                String?                        @db.VarChar(255)
  last_name_th                 String?                        @db.VarChar(255)
  first_name_en                String?                        @db.VarChar(255)
  last_name_en                 String?                        @db.VarChar(255)
  passport_number              String?                        @db.VarChar(100)
  visa_number                  String?                        @db.VarChar(100)
  work_permit_number           String?                        @db.VarChar(100)
  ninety_day_number            String?                        @db.VarChar(100)
  passport_file                String?                        @db.VarChar(255)
  passport_expiry_date         DateTime?                      @db.Date
  visa_file                    String?                        @db.VarChar(255)
  visa_expiry_date             DateTime?                      @db.Date
  work_permit_file             String?                        @db.VarChar(255)
  work_permit_expiry_date      DateTime?                      @db.Date
  ninety_day_file              String?                        @db.VarChar(255)
  ninety_day_report_date       DateTime?                      @db.Date
  other_file                   String?                        @db.VarChar(255)
  is_document_complete         Boolean?                       @default(false)
  debt_amount                  Decimal?                       @default(0.00) @db.Decimal(10, 2)
  created_at                   DateTime                       @default(now()) @db.Timestamp(0)
  updated_at                   DateTime                       @default(now()) @db.Timestamp(0)
  mou_file                     String?                        @db.VarChar(255)
  other_files                  String?                        @db.Text
  attendance_records           attendance_records[]
  payroll_run_items            payroll_run_items[]
  payroll_run_attendance_links payroll_run_attendance_links[]

  @@index([emp_code], map: "idx_edp_emp_code")
  @@index([passport_expiry_date], map: "idx_passport_expiry_date")
  @@index([visa_expiry_date], map: "idx_visa_expiry_date")
  @@index([work_permit_expiry_date], map: "idx_work_permit_expiry_date")
}

model employees {
  id                  Int      @id @default(autoincrement())
  emp_code            String?  @db.VarChar(50)
  first_name          String?  @db.VarChar(150)
  last_name           String?  @db.VarChar(150)
  gender              String?  @db.VarChar(20)
  full_name           String   @db.VarChar(150)
  nationality         String?  @db.VarChar(100)
  passport_no         String?  @db.VarChar(100)
  company_name        String?  @db.VarChar(255)
  wage_amount         Decimal  @default(0.00) @db.Decimal(12, 2)
  passport_file       String?  @db.VarChar(255)
  visa_file           String?  @db.VarChar(255)
  work_permit_file    String?  @db.VarChar(255)
  permit_90_file      String?  @db.VarChar(255)
  mou_resolution_file String?  @db.VarChar(255)
  other_files         String?  @db.Text
  note                String?  @db.Text
  created_at          DateTime @default(now()) @db.Timestamp(0)
}

model logs {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  action     String   @db.VarChar(120)
  details    String?  @db.Text
  ip_address String?  @default("") @db.VarChar(50)
  created_at DateTime @default(now()) @db.Timestamp(0)
  users      users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "logs_ibfk_1")

  @@index([user_id], map: "user_id")
}

model mou_types {
  id            Int    @id @default(autoincrement())
  mou_type_name String @db.VarChar(255)
}

model notifications {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  title      String   @db.VarChar(180)
  body       String?  @db.Text
  is_read    Boolean? @default(false)
  created_at DateTime @default(now()) @db.Timestamp(0)
  users      users?   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "notifications_ibfk_1")

  @@index([user_id], map: "user_id")
}

model password_reset_requests {
  id         Int      @id @default(autoincrement())
  email      String   @db.VarChar(150)
  note       String?  @db.Text
  status     String?  @default("pending") @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamp(0)
}

model permit_requests {
  id             Int       @id @default(autoincrement())
  user_id        Int?
  employee_id    Int?
  group_code     String    @db.VarChar(20)
  request_no     String?   @db.VarChar(100)
  tracking_url   String?   @db.Text
  current_status String?   @db.VarChar(255)
  submitted_at   DateTime? @db.DateTime(0)
  checked_at     DateTime? @db.DateTime(0)
  reviewed_at    DateTime? @db.DateTime(0)
  approved_at    DateTime? @db.DateTime(0)
  last_synced_at DateTime? @db.DateTime(0)
  source_html    String?   @db.LongText
  created_at     DateTime  @default(now()) @db.Timestamp(0)
  updated_at     DateTime  @default(now()) @db.Timestamp(0)
}

model roles {
  id          Int      @id @default(autoincrement())
  name        String   @unique(map: "name") @db.VarChar(100)
  label       String   @db.VarChar(100)
  permissions String   @db.Text
  created_at  DateTime @default(now()) @db.Timestamp(0)
  users       users[]
}

model users {
  id               Int             @id @default(autoincrement())
  role_id          Int?
  company_id       Int?
  title_name       String?         @default("") @db.VarChar(100)
  full_name        String          @db.VarChar(150)
  username         String          @unique(map: "username") @db.VarChar(80)
  email            String          @unique(map: "email") @db.VarChar(150)
  password_hash    String          @db.VarChar(255)
  is_active        Boolean?        @default(true)
  can_view         Boolean?        @default(true)
  can_download     Boolean?        @default(true)
  can_upload       Boolean?        @default(false)
  can_edit         Boolean?        @default(false)
  can_delete       Boolean?        @default(false)
  can_import       Boolean?        @default(false)
  can_view_logs    Boolean?        @default(false)
  can_backup       Boolean?        @default(false)
  can_restore      Boolean?        @default(false)
  can_manage_users Boolean?        @default(false)
  last_login_at    DateTime?       @db.DateTime(0)
  created_at       DateTime        @default(now()) @db.Timestamp(0)
  updated_at       DateTime        @default(now()) @db.Timestamp(0)
  documents        documents[]
  logs             logs[]
  notifications    notifications[]
  roles            roles?          @relation(fields: [role_id], references: [id], onUpdate: NoAction, map: "users_ibfk_1")

  @@index([role_id], map: "role_id")
}

model payroll_roles {
  id            Int             @id @default(autoincrement())
  name          String          @unique(map: "name") @db.VarChar(100)
  label         String          @db.VarChar(100)
  permissions   Json?
  created_at    DateTime        @default(now()) @db.Timestamp(0)
  updated_at    DateTime        @default(now()) @updatedAt @db.Timestamp(0)
  payroll_users payroll_users[]
}

model payroll_users {
  id            Int           @id @default(autoincrement())
  role_id       Int
  company_id    Int?
  username      String        @unique(map: "username") @db.VarChar(80)
  email         String?       @unique(map: "email") @db.VarChar(150)
  full_name     String        @db.VarChar(150)
  password_hash String        @db.VarChar(255)
  is_active     Boolean       @default(true)
  last_login_at DateTime?     @db.DateTime(0)
  created_at    DateTime      @default(now()) @db.Timestamp(0)
  updated_at    DateTime      @default(now()) @updatedAt @db.Timestamp(0)
  companies     companies?    @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_payroll_users_company")
  payroll_roles payroll_roles @relation(fields: [role_id], references: [id], map: "fk_payroll_users_role")

  @@index([role_id], map: "idx_payroll_users_role_id")
  @@index([company_id], map: "fk_payroll_users_company")
}

model attendance_records {
  id                           Int                            @id @default(autoincrement())
  employee_id                  Int?
  raw_date_text                String?                        @db.VarChar(50)
  search_text                  String?                        @db.VarChar(255)
  employee_code                String                         @db.VarChar(100)
  employee_code_13             String?                        @db.VarChar(100)
  employee_name                String                         @db.VarChar(255)
  first_name                   String?                        @db.VarChar(150)
  last_name                    String?                        @db.VarChar(150)
  work_date                    DateTime                       @db.Date
  start_time                   String?                        @db.VarChar(20)
  shift_name                   String?                        @db.VarChar(255)
  branch_code                  String?                        @db.VarChar(50)
  formula_col_1                String?                        @db.VarChar(255)
  formula_col_2                String?                        @db.VarChar(255)
  status_code                  String?                        @db.VarChar(50)
  work_time                    String?                        @db.VarChar(50)
  is_present                   Boolean                        @default(true)
  ot1                          Decimal                        @default(0.00) @db.Decimal(10, 2)
  ot15                         Decimal                        @default(0.00) @db.Decimal(10, 2)
  ot2                          Decimal                        @default(0.00) @db.Decimal(10, 2)
  ot_hours                     Decimal                        @default(0.00) @db.Decimal(10, 2)
  note                         String?                        @db.Text
  raw_row_json                 Json?
  source_sheet_id              String                         @db.VarChar(255)
  created_at                   DateTime                       @default(now()) @db.Timestamp(0)
  updated_at                   DateTime                       @updatedAt @db.Timestamp(0)
  approval_status              String                         @default("draft") @db.VarChar(20)
  created_by                   Int?
  approved_by                  Int?
  approved_at                  DateTime?                      @db.DateTime(0)
  payroll_locked_at            DateTime?                      @db.DateTime(0)
  employee_document_profiles   employee_document_profiles?    @relation(fields: [employee_id], references: [id], onUpdate: NoAction, map: "fk_attendance_employee_id")
  payroll_run_attendance_links payroll_run_attendance_links[]

  @@unique([source_sheet_id, employee_code, work_date], name: "uniq_attendance")
  @@index([employee_id], map: "idx_attendance_employee_id")
  @@index([work_date], map: "idx_attendance_work_date")
  @@index([employee_code], map: "idx_attendance_employee_code")
  @@index([approval_status], map: "idx_attendance_approval_status")
  @@index([payroll_locked_at], map: "idx_attendance_payroll_lock")
  @@index([created_by], map: "idx_attendance_created_by")
  @@index([approved_by], map: "idx_attendance_approved_by")
}

model employee_code_mapping {
  id                  Int      @id @default(autoincrement())
  sheet_employee_code String   @unique(map: "uniq_sheet_employee_code") @db.VarChar(100)
  emp_code            String   @db.VarChar(100)
  created_at          DateTime @default(now()) @db.Timestamp(0)

  @@index([emp_code], map: "idx_emp_code")
}

// Employee master mapping — นำเข้าจาก Google Sheet (master ของพนักงาน)
// แยกจาก employee_code_mapping (ที่ payroll/dashboard JOIN อยู่) เพื่อไม่ปน concern
// dedup/upsert ด้วย (source_sheet_id + code_to_find); code_to_find = main matching key
model employee_master_mapping {
  id                Int      @id @default(autoincrement())
  employee_code     String?  @db.VarChar(100) // Column A (canonical) — อาจว่าง
  first_name        String?  @db.VarChar(150) // Column B
  last_name         String?  @db.VarChar(150) // Column C
  employee_name     String?  @db.VarChar(255) // B + " " + C
  code_to_find      String   @db.VarChar(255) // Column D — main matching key
  source_sheet_id   String   @db.VarChar(255)
  source_sheet_name String?  @db.VarChar(100)
  raw_row_json      Json?
  created_at        DateTime @default(now()) @db.Timestamp(0)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamp(0)

  @@unique([source_sheet_id, code_to_find], name: "uniq_master_mapping")
  @@index([employee_code], map: "idx_emm_employee_code")
  @@index([code_to_find], map: "idx_emm_code_to_find")
}

model payroll_wage_config {
  id             Int      @id @default(autoincrement())
  description    String?  @db.VarChar(255)
  daily_wage     Decimal  @db.Decimal(10, 2)
  work_hours     Int      @default(8)
  effective_date DateTime @db.Date
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamp(0)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamp(0)
  company_id     Int?

  @@index([company_id, effective_date, is_active], map: "idx_wage_config_lookup")
}

model payroll_company_wage_configs {
  id                 BigInt   @id @default(autoincrement())
  company_id         Int      @unique(map: "company_id")
  daily_wage         Decimal  @db.Decimal(10, 2)
  work_hours_per_day Decimal  @default(8.00) @db.Decimal(5, 2)
  ot1_multiplier     Decimal  @default(1.00) @db.Decimal(5, 2)
  ot15_multiplier    Decimal  @default(1.50) @db.Decimal(5, 2)
  ot2_multiplier     Decimal  @default(2.00) @db.Decimal(5, 2)
  ot3_multiplier     Decimal  @default(3.00) @db.Decimal(5, 2)
  is_active          Boolean  @default(true)
  created_by         BigInt?
  updated_by         BigInt?
  created_at         DateTime @default(now()) @db.DateTime(0)
  updated_at         DateTime @default(now()) @updatedAt @db.DateTime(0)

  @@map("payroll_company_wage_configs")
}

model payroll_snapshots {
  id                 Int      @id @default(autoincrement())
  lock_key           String   @db.VarChar(255)
  period_start       DateTime @db.Date
  period_end         DateTime @db.Date
  source_sheet_id    String?  @db.VarChar(255)
  employee_code      String   @db.VarChar(100)
  employee_name      String   @db.VarChar(255)
  branch_code        String?  @db.VarChar(50)
  work_days          Int      @default(0)
  total_ot1          Decimal  @default(0.00) @db.Decimal(10, 2)
  total_ot15         Decimal  @default(0.00) @db.Decimal(10, 2)
  total_ot2          Decimal  @default(0.00) @db.Decimal(10, 2)
  total_ot_hours     Decimal  @default(0.00) @db.Decimal(10, 2)
  daily_wage_used    Decimal  @db.Decimal(10, 2)
  work_hours_used    Int      @default(8)
  base_income        Decimal  @default(0.00) @db.Decimal(12, 2)
  ot15_income        Decimal  @default(0.00) @db.Decimal(12, 2)
  ot2_income         Decimal  @default(0.00) @db.Decimal(12, 2)
  gross_income       Decimal  @default(0.00) @db.Decimal(12, 2)
  deduction_amount   Decimal  @default(0.00) @db.Decimal(12, 2)
  net_income         Decimal  @default(0.00) @db.Decimal(12, 2)
  locked_by_user_id  Int?
  locked_by_username String?  @db.VarChar(80)
  locked_at          DateTime @default(now()) @db.Timestamp(0)
  created_at         DateTime @default(now()) @db.Timestamp(0)

  @@unique([lock_key, employee_code], name: "uniq_snapshot_employee")
  @@index([period_start, period_end], map: "idx_snapshot_period")
  @@index([employee_code], map: "idx_snapshot_emp_code")
  @@index([lock_key], map: "idx_snapshot_lock_key")
}

model payroll_audit_logs {
  id             Int      @id @default(autoincrement())
  action         String   @db.VarChar(100)
  actor_user_id  Int?
  actor_username String?  @db.VarChar(80)
  actor_role     String?  @db.VarChar(50)
  entity_type    String   @db.VarChar(50)
  entity_scope   Json?
  metadata       Json?
  created_at     DateTime @default(now()) @db.Timestamp(0)

  @@index([action], map: "idx_audit_action")
  @@index([created_at], map: "idx_audit_created_at")
  @@index([actor_user_id], map: "idx_audit_actor")
}

model payroll_runs {
  id                    BigInt                         @id @default(autoincrement())
  company_id            Int
  period_start          DateTime                       @db.Date
  period_end            DateTime                       @db.Date
  payment_date          DateTime                       @db.Date
  status                String                         @default("DRAFT") @db.VarChar(20)
  employee_count        Int                            @default(0)
  base_income_total     Decimal                        @default(0.00) @db.Decimal(18, 2)
  overtime_income_total Decimal                        @default(0.00) @db.Decimal(18, 2)
  other_income_total    Decimal                        @default(0.00) @db.Decimal(18, 2)
  gross_income_total    Decimal                        @default(0.00) @db.Decimal(18, 2)
  deduction_total       Decimal                        @default(0.00) @db.Decimal(18, 2)
  net_income_total      Decimal                        @default(0.00) @db.Decimal(18, 2)
  calculation_version   String                         @default("payroll-v1") @db.VarChar(50)
  active_period_key     String?                        @unique(map: "uniq_payroll_run_active_period") @db.VarChar(100)
  idempotency_key       String                         @unique(map: "uniq_payroll_run_idempotency") @db.VarChar(100)
  lock_key              String?                        @unique(map: "uniq_payroll_run_lock_key") @db.VarChar(100)
  row_version           Int                            @default(1)
  created_by            Int
  reviewed_by           Int?
  approved_by           Int?
  locked_by             Int?
  paid_by               Int?
  cancelled_by          Int?
  payment_reference     String?                        @db.VarChar(255)
  bank_batch_reference  String?                        @db.VarChar(255)
  cancellation_reason   String?                        @db.Text
  created_at            DateTime                       @default(now()) @db.Timestamp(0)
  updated_at            DateTime                       @default(now()) @updatedAt @db.Timestamp(0)
  calculated_at         DateTime?                      @db.DateTime(0)
  reviewed_at           DateTime?                      @db.DateTime(0)
  approved_at           DateTime?                      @db.DateTime(0)
  locked_at             DateTime?                      @db.DateTime(0)
  paid_at               DateTime?                      @db.DateTime(0)
  cancelled_at          DateTime?                      @db.DateTime(0)
  companies             companies                      @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_payroll_runs_company")
  items                 payroll_run_items[]
  attendance_links      payroll_run_attendance_links[]

  @@index([company_id, period_start, period_end], map: "idx_payroll_runs_company_period")
  @@index([company_id, status], map: "idx_payroll_runs_company_status")
}

model payroll_run_items {
  id                          BigInt                     @id @default(autoincrement())
  payroll_run_id              BigInt
  company_id                  Int
  employee_profile_id         Int
  employee_code_snapshot      String                     @db.VarChar(100)
  employee_name_snapshot      String                     @db.VarChar(255)
  branch_code_snapshot        String?                    @db.VarChar(50)
  bank_account_snapshot       Json?
  wage_config_snapshot        Json
  calculation_input_snapshot  Json
  calculation_result_snapshot Json
  warnings                    Json?
  work_days                   Decimal                    @default(0.00) @db.Decimal(10, 2)
  half_days                   Decimal                    @default(0.00) @db.Decimal(10, 2)
  leave_days                  Decimal                    @default(0.00) @db.Decimal(10, 2)
  absent_days                 Decimal                    @default(0.00) @db.Decimal(10, 2)
  ot1_hours                   Decimal                    @default(0.00) @db.Decimal(10, 2)
  ot15_hours                  Decimal                    @default(0.00) @db.Decimal(10, 2)
  ot2_hours                   Decimal                    @default(0.00) @db.Decimal(10, 2)
  base_income                 Decimal                    @default(0.00) @db.Decimal(18, 2)
  overtime_income             Decimal                    @default(0.00) @db.Decimal(18, 2)
  other_income                Decimal                    @default(0.00) @db.Decimal(18, 2)
  gross_income                Decimal                    @default(0.00) @db.Decimal(18, 2)
  total_deductions            Decimal                    @default(0.00) @db.Decimal(18, 2)
  net_income                  Decimal                    @default(0.00) @db.Decimal(18, 2)
  created_at                  DateTime                   @default(now()) @db.Timestamp(0)
  updated_at                  DateTime                   @default(now()) @updatedAt @db.Timestamp(0)
  payroll_run                 payroll_runs               @relation(fields: [payroll_run_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_payroll_run_items_run")
  company                     companies                  @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_payroll_run_items_company")
  employee_profile            employee_document_profiles @relation(fields: [employee_profile_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_payroll_run_items_employee")

  @@unique([payroll_run_id, employee_profile_id], name: "uniq_payroll_run_employee")
  @@index([company_id, employee_profile_id], map: "idx_payroll_run_items_company_employee")
}

model payroll_run_attendance_links {
  id                    BigInt                     @id @default(autoincrement())
  payroll_run_id        BigInt
  company_id            Int
  employee_profile_id   Int
  attendance_record_id  Int
  active_attendance_key String?                    @unique(map: "uniq_active_payroll_attendance") @db.VarChar(40)
  status                String                     @default("ACTIVE") @db.VarChar(20)
  linked_at             DateTime                   @default(now()) @db.Timestamp(0)
  released_at           DateTime?                  @db.DateTime(0)
  payroll_run           payroll_runs               @relation(fields: [payroll_run_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_payroll_run_attendance_run")
  company               companies                  @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_payroll_run_attendance_company")
  employee_profile      employee_document_profiles @relation(fields: [employee_profile_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_payroll_run_attendance_employee")
  attendance_record     attendance_records         @relation(fields: [attendance_record_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_payroll_run_attendance_record")

  @@unique([payroll_run_id, attendance_record_id], name: "uniq_payroll_run_attendance")
  @@index([company_id, payroll_run_id], map: "idx_payroll_run_attendance_company_run")
}
