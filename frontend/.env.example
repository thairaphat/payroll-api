# ============================================================
# Payroll Companion (Frontend) — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# All VITE_ variables are bundled into the client build — do NOT put secrets here.
# NEVER commit .env to version control.
# ============================================================

# --- Backend API URL ---
# Must match the running payroll-backend server.
# Development: http://localhost:3001
# Production:  https://api.payroll.yourcompany.com (no trailing slash)
VITE_API_URL=http://localhost:3001

# --- Google Sheet ID ---
# The spreadsheet ID from the Google Sheets URL:
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
# Used by the Attendance page to pre-fill the sheet ID for the sync action.
# Example (replace with your actual sheet ID):
VITE_GOOGLE_SHEET_ID=YOUR_GOOGLE_SPREADSHEET_ID_HERE
