# ============================================================
# Payroll System — Production Environment
# ============================================================
# chmod 600 this file after filling in real values.
# NEVER commit this file to version control.
# ============================================================

# ── Database (must match MARIADB_* values below) ──────────────────────────────
DATABASE_URL="mysql://payroll_user:STRONG_DB_PASS@mariadb:3306/chaiyade_dms"
DATABASE_URL_DMS="mysql://payroll_user:STRONG_DB_PASS@mariadb:3306/chaiyade_dms"
DATABASE_URL_WP106="mysql://payroll_user:STRONG_DB_PASS@mariadb:3306/chaiyade_wp106"
MARIADB_ALLOW_PUBLIC_KEY_RETRIEVAL=true

# MariaDB container bootstrap (used by the mariadb service)
MARIADB_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASS
MARIADB_DATABASE=chaiyade_dms
MARIADB_USER=payroll_user
MARIADB_PASSWORD=STRONG_DB_PASS

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=GENERATED_64_CHAR_SECRET_HERE

# ── CORS ───────────────────────────────────────────────────────────────────────
# Replace with your actual production domain
ALLOWED_ORIGINS=https://payroll.yourdomain.com

# ── Runtime ────────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Google Sheets API ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_EMAIL=payroll-bot@payroll-system-494708.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── Frontend build args (used by docker compose build) ────────────────────────
VITE_GOOGLE_SHEET_ID=YOUR_SHEET_ID_HERE
# VITE_API_URL is intentionally empty — Nginx proxies to same origin
